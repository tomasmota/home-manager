{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "~/.agents/AGENTS.md"
  ],
  "skills": {
    "paths": [
      "~/.agents/local-skills"
    ]
  },
  "plugin": ["@anthonyhaussman/opencode-agy-auth@1.1.13"],
  "model": "openai/gpt-5.6-terra",
  "agent": {
    "build": {
      "model": "openai/gpt-5.6-terra",
      "variant": "medium"
    },
    "infra-investigate": {
      "description": "Performs bounded, read-only infrastructure and documentation investigations; use for cloud inventory, logs, and diagnostic research whose raw output should stay out of the primary session.",
      "mode": "subagent",
      "steps": 12,
      "permission": {
        "edit": "deny",
        "task": "deny"
      },
      "prompt": "Perform a read-only investigation. Never modify files or infrastructure, and do not run shell commands that can do so. Use only the narrowest useful queries. Return a concise conclusion, verified evidence with source links or exact bounded commands, unresolved questions, and the next most discriminating action. Do not return raw logs, plans, YAML, or documentation."
    }
  },
  "provider": {
    "google-agy": {
      "options": {
        "projectId": "signicat-gemini-enterprise"
      }
    }
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--no-usage-statistics",
        "--no-performance-crux"
      ],
      "timeout": 120000,
      "enabled": false
    },
    "opentofu": {
      "type": "remote",
      "url": "https://mcp.opentofu.org/mcp",
      "enabled": false
    },
    "incident-io": {
      "type": "remote",
      "url": "https://mcp.incident.io/mcp",
      "enabled": false
    },
    "confluence": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2",
      "enabled": false
    }
  },
  "tools": {
    "confluence_*": false,
    "confluence_getAccessibleAtlassianResources": true,
    "confluence_getConfluencePage": true,
    "confluence_getJiraIssue": true,
    "confluence_searchConfluenceUsingCql": true,
    "confluence_searchJiraIssuesUsingJql": true,
    "chrome-devtools_performance_*": false,
    "chrome-devtools_lighthouse_audit": false,
    "chrome-devtools_take_heapsnapshot": false
  },
  "experimental": {
    "disable_paste_summary": true
  },
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 16000
  },
  "compaction": {
    "auto": true,
    "prune": false,
    "tail_turns": 4,
    "preserve_recent_tokens": 12000
  },
  "command": {
    "research": {
      "description": "Run a read-only infrastructure or documentation investigation in a child session",
      "agent": "infra-investigate",
      "subtask": true,
      "template": "Investigate: $ARGUMENTS\n\nRead findings.md if it exists. Perform a read-only investigation using only the narrowest useful queries. Do not modify files or infrastructure. Return: conclusion; verified evidence with commands or source links; unresolved questions; recommended next action. Do not return raw logs, plans, YAML, or documentation."
    }
  },
  "permission": {
    "bash": {
      "*": "allow",

      "python3*": "ask",
      "python3 -m py_compile*": "allow",
      "bash*": "ask",
      "bash -n*": "allow",
      "bash -o noexec*": "allow",

      "node*": "ask",
      "node -c*": "allow",
      "node --check*": "allow",

      "tofu*": "ask",
      "tofu -help*": "allow",
      "tofu --help*": "allow",
      "tofu -version*": "allow",
      "tofu version*": "allow",
      "tofu plan*": "allow",
      "tofu init*": "allow",
      "tofu fmt*": "allow",
      "tofu validate*": "allow",
      "tofu graph*": "allow",
      "tofu metadata functions*": "allow",
      "tofu show*": "allow",
      "tofu output*": "allow",
      "tofu providers": "allow",
      "tofu providers -*": "allow",
      "tofu state list*": "allow",
      "tofu state show*": "allow",
      "tofu state pull*": "allow",
      "tofu workspace list*": "allow",
      "tofu workspace show*": "allow",
      "tofu providers schema*": "allow",
      "tofu apply*": "deny",
      "tofu destroy*": "deny",
      "tofu state rm*": "deny",

      "git push --force*": "deny",
      "git push -f*": "deny",

      "glab*": "ask",
      "glab help*": "allow",
      "glab version*": "allow",
      "glab auth status*": "allow",
      "glab config get*": "allow",
      "glab config list*": "allow",
      "glab alias list*": "allow",
      "glab* list*": "allow",
      "glab* view*": "allow",
      "glab* status*": "allow",
      "glab* search*": "allow",
      "glab* diff*": "allow",
      "glab* lint*": "allow",
      "glab api --method GET*": "allow",
      "glab api -X GET*": "allow",
      "glab auth revoke*": "deny",
      "glab auth logout*": "deny",
      "glab* delete*": "deny",
      "glab* archive*": "deny",
      "glab* revoke*": "deny",

      "gcloud*": "ask",
      "gcloud config list*": "allow",
      "gcloud config get-value*": "allow",
      "gcloud auth list*": "allow",
      "gcloud services list*": "allow",
      "gcloud asset search-all-resources*": "allow",
      "gcloud* list*": "allow",
      "gcloud* describe*": "allow",
      "gcloud storage ls*": "allow",
      "gcloud logging read*": "allow",
      "gcloud* get-iam-policy*": "allow",
      "gcloud identity groups memberships check-transitive-membership*": "allow",
      "gcloud policy-troubleshoot iam *": "allow",
      "gcloud projects delete*": "deny",
      "gcloud organizations*": "deny",
      "gcloud auth revoke*": "deny",

      "kubectl*": "ask",
      "kubectl* get*": "allow",
      "kubectl* describe*": "allow",
      "kubectl* explain*": "allow",
      "kubectl* diff*": "allow",
      "kubectl* logs*": "allow",
      "kubectl* top*": "allow",
      "kubectl* events*": "allow",
      "kubectl* version*": "allow",
      "kubectl* cluster-info*": "allow",
      "kubectl* api-resources*": "allow",
      "kubectl* api-versions*": "allow",
      "kubectl* config view*": "allow",
      "kubectl* config current-context*": "allow",
      "kubectl* config get-contexts*": "allow",

      "helm*": "ask",
      "helm list*": "allow",
      "helm ls*": "allow",
      "helm search*": "allow",
      "helm show*": "allow",
      "helm status*": "allow",
      "helm get*": "allow",
      "helm version*": "allow",
      "helm history*": "allow",
      "helm template*": "allow",
      "helm lint*": "allow",
      "helm env*": "allow",
      "cmctl*": "ask",
      "istioctl*": "ask",
      "istioctl validate*": "allow",
      "istioctl proxy-status*": "allow",
      "argocd*": "ask"
    },
    "external_directory": "allow",
    "chrome-devtools_*": "allow"
  }
}
