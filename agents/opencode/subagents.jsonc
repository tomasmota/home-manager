{
  "fallbacks": {
    "openai": "claude-subscription/claude-opus-5-5",
    "claude-subscription": "openai/gpt-6.1-sol#high"
  },
  "quotaLow": {
    "fiveHour": 20,
    "weekly": 10
  },
  "permissions": [
    {
      "action": "question",
      "resource": "*",
      "effect": "deny",
      "when": "child"
    },
    {
      "action": "subagent",
      "resource": "*",
      "effect": "deny",
      "when": "child"
    },
    {
      "action": "subagent",
      "resource": "explore",
      "effect": "allow",
      "when": "child"
    }
  ],
  "agents": {
    "general": {
      "description": "General-purpose research and delegated execution. Use explore for read-only discovery; the parent remains responsible for integration.",
      "system": "Work autonomously on the bounded delegated task, preserve unrelated changes, validate proportionately and report concise evidence and blockers.",
      "mode": "all",
      "model": "claude-subscription/claude-sonnet-5-5#high"
    },
    "coder": {
      "description": "Implementation, refactoring and debugging of code, scripts, infrastructure and UI.",
      "mode": "all",
      "model": "claude-subscription/claude-opus-5-5#high"
    },
    "terminal": {
      "description": "Terminal-driven investigation using shell commands, CLIs, logs and focused build checks.",
      "mode": "all",
      "model": "openai/gpt-6.1-sol#xhigh"
    },
    "quick": {
      "description": "Small tasks with an obvious approach: lookups, mechanical edits and focused value changes, not uncertain design.",
      "mode": "all",
      "model": "opencode/space-bunny-free"
    },
    "deep": {
      "description": "Hard debugging, design and high-level decisions that need careful reasoning; not merely long work.",
      "mode": "all",
      "model": "claude-subscription/claude-opus-5-5#xhigh"
    },
    "explore": {
      "description": "Read-only file/code/documentation discovery. Search, read and fetch; no shell or changes. Return compressed conclusions with exact refs and unresolved uncertainties.",
      "system": "You are a read-only discovery agent. Search, read and fetch documentation to answer the parent's bounded question. Do not change files or run shell commands. Return concise conclusions, exact file/line refs, key relationships, the smallest useful next locations and unresolved uncertainty; avoid raw outputs or full files.",
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "websearch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "*.env",
          "effect": "ask"
        },
        {
          "action": "read",
          "resource": "*.env.*",
          "effect": "ask"
        },
        {
          "action": "read",
          "resource": "*.env.example",
          "effect": "allow"
        }
      ],
      "mode": "subagent",
      "model": "opencode/space-bunny-free"
    },
    "reviewer": {
      "description": "Independent adversarial review for concrete bugs, regressions, risks and missing tests. Does not edit; shell checks are permitted, so it is not a strict read-only sandbox.",
      "system": "Review the implementation independently against surrounding code and primary documentation. Report only actionable findings, ordered by severity with exact refs, impact and cause. If there are none, say so and note testing gaps. Do not edit files.",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "write",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "patch",
          "resource": "*",
          "effect": "deny"
        }
      ],
      "mode": "subagent",
      "model": "openai/gpt-6.1-sol#xhigh"
    },
    "free": {
      "description": "General-purpose free delegated work. The platform adapter selects this role's model.",
      "system": "Handle the bounded task autonomously, verify proportionately and report the outcome concisely.",
      "mode": "subagent",
      "model": "opencode/muse-spark-1.3-contributor-free"
    }
  }
}
