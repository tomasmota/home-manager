      "bash --version*": "allow",
      "zsh -n*": "allow",
      "node -c*": "allow",
      "node --check*": "allow",
      "node --version*": "allow",
      "tofu -help*": "allow",
      "tofu --help*": "allow",
      "tofu -version*": "allow",
