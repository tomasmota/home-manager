diff --git a/tests/lib/nodes.luau b/tests/lib/nodes.luau
index 20e3ec3..2777bc9 100644
--- a/tests/lib/nodes.luau
+++ b/tests/lib/nodes.luau
@@ -60,6 +60,23 @@ function M.ownText(node: Node): string
 			table.insert(out, spansText(item.v))
 		end
 	end
+	if node.k == "table" and type(p.cols) == "table" and type(p.rows) == "table" then
+		for _, col in p.cols do
+			table.insert(out, spansText(col.head))
+		end
+		for _, row in p.rows do
+			for _, col in p.cols do
+				local cell = row.cells[col.id]
+				if type(cell) == "table" and type(cell.badge) == "table" then
+					table.insert(out, spansText(cell.badge.text))
+				elseif type(cell) == "table" and cell.text ~= nil then
+					table.insert(out, spansText(cell.text))
+				else
+					table.insert(out, spansText(cell))
+				end
+			end
+		end
+	end
 	if node.k == "tree" then
 		treeText(p.nodes, out)
 	end
