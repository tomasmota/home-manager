      "helm show*": "allow",
      "helm status*": "allow",
      "helm get*": "allow",
      "helm version*": "allow",
      "helm history*": "allow",
      "helm template*": "allow",
      "helm lint*": "allow",
      "helm env*": "allow",
      "cmctl version*": "allow",
      "cmctl --version*": "allow",
      "istioctl version*": "allow",
      "istioctl --version*": "allow",
      "argocd version*": "allow",
      "argocd --version*": "allow",
      "tmux*": "allow",
      "minions-tools*": "allow"
    },
    "external_directory": "allow",
    "chrome-devtools_*": "allow"
  }
}
