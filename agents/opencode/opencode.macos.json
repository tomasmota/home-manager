{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "~/.agents/AGENTS.md"
  ],
  "skills": {
    "paths": [
      "~/.agents/local-skills"
    ]
  },
  "plugin": [],
  "model": "openai/gpt-5.6-sol#medium",
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--no-usage-statistics",
        "--no-performance-crux"
      ],
      "timeout": 120000,
      "enabled": false
    },
    "opentofu": {
      "type": "remote",
      "url": "https://mcp.opentofu.org/mcp",
      "enabled": false
    },
    "incident-io": {
      "type": "remote",
      "url": "https://mcp.incident.io/mcp",
      "enabled": false
    },
    "confluence": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2",
      "enabled": true
    }
  },
  "tools": {
    "confluence_*": false,
    "confluence_getAccessibleAtlassianResources": true,
    "confluence_getConfluencePage": true,
    "confluence_getJiraIssue": true,
    "confluence_searchConfluenceUsingCql": true,
    "confluence_searchJiraIssuesUsingJql": true,
    "confluence_editJiraIssue": true,
    "confluence_transitionJiraIssue": true,
    "confluence_getTransitionsForJiraIssue": true,
    "confluence_updateConfluencePage": true,
    "chrome-devtools_performance_*": false,
    "chrome-devtools_lighthouse_audit": false,
    "chrome-devtools_take_heapsnapshot": false
  },
  "experimental": {
    "disable_paste_summary": true
  },
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 16000
  },
  "compaction": {
    "auto": true,
    "prune": false,
    "tail_turns": 4,
    "preserve_recent_tokens": 12000
  },
  "permission": {
    "bash": {
      "*": "ask",
      "~/.agents/local-skills/show-me/show-mermaid*": "allow",
      "/Users/tomas/.agents/local-skills/show-me/show-mermaid*": "allow",
      "ls*": "allow",
      "dig*": "allow",
      "delv*": "allow",
      "wt*": "allow",
      "cat*": "allow",
      "head*": "allow",
      "tail*": "allow",
      "wc*": "allow",
      "file*": "allow",
      "stat*": "allow",
      "du*": "allow",
      "df*": "allow",
      "pwd*": "allow",
      "which*": "allow",
      "whoami*": "allow",
      "hostname*": "allow",
      "date*": "allow",
      "rg*": "allow",
      "grep*": "allow",
      "find*": "allow",
      "fd*": "allow",
      "jq*": "allow",
      "yq*": "allow",
      "diff*": "allow",
      "echo*": "allow",
      "printf*": "allow",
      "test*": "allow",
      "true*": "allow",
      "false*": "allow",
      "uname*": "allow",
      "dirname*": "allow",
