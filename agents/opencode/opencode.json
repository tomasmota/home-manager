{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "~/.agents/AGENTS.md"
  ],
  "skills": {
    "paths": [
      "~/.agents/local-skills"
    ]
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--no-usage-statistics",
        "--no-performance-crux"
      ],
      "timeout": 120000
    },
    "kubernetes": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "kubernetes-mcp-server@latest",
        "--read-only",
        "--toolsets=config,core"
      ],
      "timeout": 120000
    }
  },
  "experimental": {
    "disable_paste_summary": true
  },
  "compaction": {
    "auto": true,
    "prune": false,
    "tail_turns": 4,
    "preserve_recent_tokens": 12000
  },
  "permission": "allow"
}
