{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin"
  },
  "diffs": {
    "wrap": "word"
  },
  "prompt": {
    "paste": "full"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "thinking": "hide"
  },
  "tabs": {
    "mode": "off"
  },
  "animations": true,
  "attention": {
    "notifications": true,
    "sound": false
  },
  "plugins": [
    "./tui-plugins/quota-watch",
    "./tui-plugins/tmux-status"
  ]
}
