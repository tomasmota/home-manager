{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "skills": [
    "~/.agents/local-skills",
    "~/.agents/team-skills"
  ],
  "model": "openai/gpt-6.1-sol#high",
  "providers": {
    "openai": {
      "models": {
        "gpt-6.1-sol": {
          "settings": {
            "reasoningEffort": "high"
          }
        }
      }
    },
    "inco": {
      "body": {
        "reasoning_effort": "high"
      }
    },
    "claude-subscription": {
      "name": "Claude Subscription (CLIProxyAPI)",
      "env": [
        "CLIPROXYAPI_API_KEY"
      ],
      "canonical": "anthropic",
      "package": "@opencode/ai/providers/anthropic",
      "settings": {
        "baseURL": "http://127.0.0.1:8317/v1",
        "apiKey": "{env:CLIPROXYAPI_API_KEY}"
      },
      "models": {
        "claude-sonnet-5-5": {
          "cost": {
            "input": 0,
            "output": 0
          }
        },
        "claude-opus-5-5": {
          "cost": {
            "input": 0,
            "output": 0
          }
        },
        "claude-opus-5": {
          "cost": {
            "input": 0,
            "output": 0
          }
        },
        "claude-sonnet-5": {
          "cost": {
            "input": 0,
            "output": 0
          }
        },
        "claude-opus-4-6": {
          "cost": {
            "input": 0,
            "output": 0
          }
        },
        "claude-sonnet-4-6": {
          "cost": {
            "input": 0,
            "output": 0
          }
        },
        "claude-haiku-4-5-20251001": {
          "cost": {
            "input": 0,
            "output": 0
          }
        }
      }
    }
  },
  "experimental": {
    "subagent_depth": 2,
    "policies": [
      {
        "action": "provider.use",
        "resource": "google-vertex",
        "effect": "deny"
      }
    ]
  },
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--auto-connect",
          "--user-data-dir=/Users/tomas/Library/Application Support/Vivaldi",
          "--no-usage-statistics",
          "--no-performance-crux"
        ],
        "disabled": false,
        "timeout": {
          "catalog": 120000,
          "execution": 120000
        }
      },
      "opentofu": {
        "type": "remote",
        "url": "https://mcp.opentofu.org/mcp",
        "disabled": true
      },
      "incident-io": {
        "type": "remote",
        "url": "https://mcp.incident.io/mcp",
        "disabled": true
      },
      "confluence": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v1/mcp/authv2",
        "disabled": false
      }
    }
  },
