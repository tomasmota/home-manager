{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "~/.agents/AGENTS.md"
  ],
  "skills": {
    "paths": [
      "~/.agents/local-skills"
    ]
  },
  "plugin": [
    ["opencode-auto-permissions@0.2.10", { "model": "openai/gpt-5.6-luna", "debug": "/home/tomas/.local/share/opencode/auto-permissions-debug.jsonl" }]
  ],
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--no-usage-statistics",
        "--no-performance-crux"
      ],
      "timeout": 120000
    }
  },
  "experimental": {
    "disable_paste_summary": true
  },
  "compaction": {
    "auto": true,
    "prune": false,
    "tail_turns": 4,
    "preserve_recent_tokens": 12000
  },
  "permission": {
    "bash": {
      "*": "ask",

      "ls*": "allow",
      "cat*": "allow",
      "head*": "allow",
      "tail*": "allow",
      "wc*": "allow",
      "file*": "allow",
      "stat*": "allow",
      "du*": "allow",
      "df*": "allow",
      "pwd*": "allow",
      "which*": "allow",
      "whoami*": "allow",
      "hostname*": "allow",
      "date*": "allow",
      "rg*": "allow",
      "grep*": "allow",
      "find*": "allow",
      "fd*": "allow",
      "jq*": "allow",
      "yq*": "allow",
      "diff*": "allow",
      "echo*": "allow",
      "printf*": "allow",
      "test*": "allow",
      "true*": "allow",
      "false*": "allow",
      "uname*": "allow",
      "dirname*": "allow",
      "basename*": "allow",
      "realpath*": "allow",
      "readlink*": "allow",
      "less*": "allow",
      "tree*": "allow",
      "cut*": "allow",
      "sort*": "allow",
      "uniq*": "allow",
      "tr*": "allow",

      "npm*": "allow",
      "pnpm*": "allow",
      "nix*": "allow",
      "cargo*": "allow",
      "go*": "allow",
      "make*": "allow",
      "pytest*": "allow",
      "uv*": "allow",
      "uvx*": "allow",

      "python3 -m py_compile*": "allow",
      "python3 --version*": "allow",
      "bash -n*": "allow",
      "bash -o noexec*": "allow",
      "bash --version*": "allow",
      "zsh -n*": "allow",

      "node -c*": "allow",
      "node --check*": "allow",
      "node --version*": "allow",

      "tofu -help*": "allow",
      "tofu --help*": "allow",
      "tofu -version*": "allow",
      "tofu --version*": "allow",
      "tofu version*": "allow",
      "tofu plan*": "allow",
      "tofu init*": "allow",
      "tofu fmt*": "allow",
      "tofu validate*": "allow",
      "tofu graph*": "allow",
      "tofu metadata functions*": "allow",
      "tofu show*": "allow",
      "tofu output*": "allow",
      "tofu providers": "allow",
      "tofu providers -*": "allow",
      "tofu state list*": "allow",
      "tofu state show*": "allow",
      "tofu state pull*": "allow",
      "tofu workspace list*": "allow",
      "tofu workspace show*": "allow",
      "tofu providers schema*": "allow",
      "tofu apply*": "deny",
      "tofu destroy*": "deny",
      "tofu state rm*": "deny",

      "git --version*": "allow",
      "git version*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git remote*": "allow",
      "git rev-parse*": "allow",
      "git ls-files*": "allow",
      "git grep*": "allow",
      "git blame*": "allow",
      "git ls-remote*": "allow",
      "git stash list*": "allow",

      "glab help*": "allow",
      "glab --version*": "allow",
      "glab version*": "allow",
      "glab auth status*": "allow",
      "glab config get*": "allow",
      "glab config list*": "allow",
      "glab alias list*": "allow",
      "glab* list*": "allow",
      "glab* view*": "allow",
      "glab* status*": "allow",
      "glab* search*": "allow",
      "glab* diff*": "allow",
      "glab* lint*": "allow",
      "glab api --method GET*": "allow",
      "glab api -X GET*": "allow",
      "glab auth revoke*": "deny",
      "glab auth logout*": "deny",
      "glab* delete*": "deny",
      "glab* archive*": "deny",
      "glab* revoke*": "deny",

      "gh* list*": "allow",
      "gh* view*": "allow",
      "gh* status*": "allow",
      "gh* search*": "allow",

      "gcloud version*": "allow",
      "gcloud config list*": "allow",
      "gcloud config get-value*": "allow",
      "gcloud auth list*": "allow",
      "gcloud services list*": "allow",
      "gcloud asset search-all-resources*": "allow",
      "gcloud* list*": "allow",
      "gcloud* describe*": "allow",
      "gcloud storage ls*": "allow",
      "gcloud logging read*": "allow",
      "gcloud* get-iam-policy*": "allow",
      "gcloud identity groups memberships check-transitive-membership*": "allow",
      "gcloud policy-troubleshoot iam *": "allow",
      "gcloud projects delete*": "deny",
      "gcloud organizations*": "deny",
      "gcloud auth revoke*": "deny",

      "kubectl --version*": "allow",
      "kubectl* get*": "allow",
      "kubectl* describe*": "allow",
      "kubectl* explain*": "allow",
      "kubectl* diff*": "allow",
      "kubectl* logs*": "allow",
      "kubectl* top*": "allow",
      "kubectl* events*": "allow",
      "kubectl* version*": "allow",
      "kubectl* cluster-info*": "allow",
      "kubectl* api-resources*": "allow",
      "kubectl* api-versions*": "allow",
      "kubectl* config view*": "allow",
      "kubectl* config current-context*": "allow",
      "kubectl* config get-contexts*": "allow",

      "helm --version*": "allow",
      "helm list*": "allow",
      "helm ls*": "allow",
      "helm search*": "allow",
      "helm show*": "allow",
      "helm status*": "allow",
      "helm get*": "allow",
      "helm version*": "allow",
      "helm history*": "allow",
      "helm template*": "allow",
      "helm lint*": "allow",
      "helm env*": "allow",

      "cmctl version*": "allow",
      "cmctl --version*": "allow",
      "istioctl version*": "allow",
      "istioctl --version*": "allow",
      "argocd version*": "allow",
      "argocd --version*": "allow",

      "tmux capture-pane*": "allow",
      "tmux list-*": "allow",
      "tmux display-message*": "allow",
      "tmux show-options*": "allow",
      "tmux show-window-options*": "allow"
    },
    "external_directory": "allow"
  }
}
