// OpenCode agents, generated by the agent-routes plugin (agents/opencode/plugins/agent-routes).
// The model-selector skill also reads this file. Edits apply live: no restart or nix switch.
// If an edit is invalid, the plugin keeps the last good version and logs why.
//
// model: exact `provider/model[#variant]` from `opencode models` (colons are part of the ID).
// mode: "all" = selectable as a primary agent and as a subagent; "subagent" = subagent only.
// description: what the delegating model reads when choosing an agent, so describe when to use it.
{
  // When a provider's quota is low, its agents run on the fallback model instead.
  // A fallback without #variant keeps each agent's own variant.
  "fallbacks": {
    "openai": "claude-subscription/claude-opus-5-5",
    "claude-subscription": "openai/gpt-6.1-sol#high"
  },
  // Percent left below which a provider counts as low.
  "quotaLow": { "fiveHour": 20, "weekly": 10 },

  // Applied to every agent before its own permissions (last match wins).
  // Each agent starts from OpenCode's defaults (allow all; ask for .env reads and
  // external directories); global `permissions` in opencode.json are appended after.
  // `when: "child"` rules apply only when the agent runs as a subagent; `when` rules
  // are evaluated after the agent's other rules.
  "permissions": [
    // As subagents, agents work autonomously and may only delegate to read-only explore.
    { "action": "question", "resource": "*", "effect": "deny", "when": "child" },
    { "action": "subagent", "resource": "*", "effect": "deny", "when": "child" },
    { "action": "subagent", "resource": "explore", "effect": "allow", "when": "child" }
  ],

  "agents": {
    "general": {
      "mode": "all",
      "model": "claude-subscription/claude-sonnet-5-5#high",
      "description": "Default general-purpose agent for researching questions and executing multi-step tasks. Use it for most delegated work and for running multiple units of work in parallel, unless another agent clearly fits better."
    },
    "coder": {
      "mode": "all",
      "model": "claude-subscription/claude-opus-5-5#high",
      "description": "Go-to agent for real coding: writing, refactoring, and debugging code, including Terraform, scripts, and UI work."
    },
    "terminal": {
      "mode": "all",
      "model": "openai/gpt-6.1-sol#xhigh",
      "description": "Terminal-driven investigation: runs shell commands and CLIs (git, kubectl, gcloud, logs, builds) to explore systems and answer questions about live state. Use it when the answer comes from running commands rather than reading code."
    },
    "quick": {
      "mode": "all",
      "model": "inco/glm-5.3-flash:fast",
      "description": "Fast, cheap agent for small tasks with an obvious approach: lookups, mechanical edits, and value changes in config files like YAML, JSON, or TOML, including committing and opening an MR. Do not use it when design or debugging uncertainty remains."
    },
    "deep": {
      "mode": "all",
      "model": "claude-subscription/claude-opus-5-5#xhigh",
      "description": "Maximum-effort agent for high-level work that needs careful reasoning, such as deriving test fixtures from requirements, designing an approach, or hard debugging. Do not choose it merely because work is long or broad."
    },
    "explore": {
      "model": "inco/glm-5.3-flash:fast",
      "description": "Fast agent specialized for exploring codebases. Use this agent to quickly find files, search code, and answer codebase questions.",
      // Read-only, matching OpenCode's built-in explore.
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*.env", "effect": "ask" },
        { "action": "read", "resource": "*.env.*", "effect": "ask" },
        { "action": "read", "resource": "*.env.example", "effect": "allow" }
      ],
      "system": [
        "You are a file search specialist. You excel at thoroughly navigating and exploring codebases.",
        "",
        "Your strengths:",
        "- Rapidly finding files using glob patterns",
        "- Searching code and text with powerful regex patterns",
        "- Reading and analyzing file contents",
        "",
        "Guidelines:",
        "- Use Glob for broad file pattern matching",
        "- Use Grep for searching code contents with regex",
        "- Use Read when you know the specific file path you need to read",
        "- Adapt your search approach based on the thoroughness level specified by the caller",
        "- Return file paths as absolute paths in your final response",
        "- Do not create files or run commands that modify the user's system",
        "",
        "Complete the user's search request efficiently and report your findings clearly."
      ]
    },
    "reviewer": {
      "model": "openai/gpt-5.6-sol#medium",
      "description": "Reviews implemented changes for correctness, regressions, risks, and missing tests. Use after an agent finishes an implementation and needs an independent code review.",
      "permissions": [{ "action": "edit", "resource": "*", "effect": "deny" }],
      "system": [
        "Review the implementation independently. Find concrete bugs, behavioral regressions, security or reliability risks, and missing or inadequate tests.",
        "",
        "Start by examining the change and the surrounding code necessary to understand its behavior. Validate assumptions against the repository rather than speculating. Run focused read-only checks when they would substantiate a finding.",
        "",
        "Report only actionable findings. Order them by severity and include each finding's file and line reference, the impact, and why the implementation causes it. If there are no findings, say so explicitly and note any residual testing gaps. Do not make code changes."
      ]
    },
    "free": {
      "model": "opencode/muse-spark-1.3-contributor-free",
      "description": "General-purpose agent that uses the configured free model. Use only when the user explicitly asks to use free subagents.",
      "system": "Handle the delegated task as a capable general-purpose engineering agent. Work autonomously, validate results proportionately, and report the outcome concisely."
    }
  }
}
